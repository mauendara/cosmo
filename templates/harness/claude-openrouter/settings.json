{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Bash"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "ScheduleWakeup",
      "ToolSearch",
      "TaskOutput"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent/claude-openrouter/hooks/test_path_guard.py\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent/claude-openrouter/hooks/annotation_guard.py\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent/claude-openrouter/hooks/commit_integrity_guard.py\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent/claude-openrouter/hooks/background_task_guard.py\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
